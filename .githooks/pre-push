#!/usr/bin/env sh
set -eu

REPO_ROOT=$(git rev-parse --show-toplevel)
"$REPO_ROOT/.githooks/python-env" "$REPO_ROOT"

if [ -x "$REPO_ROOT/.venv/Scripts/python.exe" ]; then
  PYTHON="$REPO_ROOT/.venv/Scripts/python.exe"
elif [ -x "$REPO_ROOT/.venv/bin/python" ]; then
  PYTHON="$REPO_ROOT/.venv/bin/python"
else
  echo "ERROR: the worktree-local .venv is not executable after bootstrap." >&2
  exit 1
fi

exec "$PYTHON" "$REPO_ROOT/Scripts/quality_gate.py" push \
  --remote-name "${1:-}" \
  --remote-url "${2:-}"
