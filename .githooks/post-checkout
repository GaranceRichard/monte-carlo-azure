#!/usr/bin/env sh
set -eu

# Only the quality orchestrator marks its disposable detached worktrees. A
# detached contributor worktree, including one created by Codex, must bootstrap.
if [ "${MONTECARLO_CANONICAL_WORKTREE:-}" = "1" ]; then
  exit 0
fi

REPO_ROOT=$(git rev-parse --show-toplevel)
"$REPO_ROOT/.githooks/python-env" "$REPO_ROOT"
