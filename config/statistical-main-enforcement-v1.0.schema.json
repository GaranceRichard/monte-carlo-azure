{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://montecarlo.local/schemas/statistical-main-enforcement/1.0",
  "title": "Blocking statistical enforcement policy for the main profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["policy_id", "version", "profile", "scope", "required_controls", "statuses"],
  "properties": {
    "policy_id": { "const": "mca-statistical-main-enforcement" },
    "version": { "const": "1.0" },
    "profile": { "const": "main" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["guarantee", "limitation"],
      "properties": {
        "guarantee": { "type": "string", "minLength": 1 },
        "limitation": { "type": "string", "minLength": 1 }
      }
    },
    "required_controls": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/control" }
    },
    "statuses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/status" }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "strings": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "node", "needs", "reproduce"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "node": { "type": "string", "pattern": "^statistical-[a-z0-9-]+$" },
        "needs": { "$ref": "#/$defs/strings" },
        "reproduce": { "type": "string", "minLength": 1 }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "disposition", "final_allowed"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "disposition": {
          "enum": ["accepted", "blocking", "informative", "not_applicable", "forbidden_final"]
        },
        "final_allowed": { "type": "boolean" }
      }
    }
  }
}
