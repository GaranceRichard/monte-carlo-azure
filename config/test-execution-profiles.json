{
  "schemaVersion": "1.0.0",
  "schema": "config/test-execution-profiles.schema.json",
  "profiles": [
    {
      "id": "pr",
      "includes": ["pr"],
      "description": "Retour rapide, déterministe et protection immédiate des changements."
    },
    {
      "id": "main",
      "includes": ["pr", "main"],
      "description": "Régression complète et contrôles d'intégration après fusion sur main."
    },
    {
      "id": "nightly",
      "includes": ["pr", "main", "nightly"],
      "description": "Contrôles lourds, larges et non fonctionnels planifiés."
    },
    {
      "id": "release",
      "includes": ["pr", "main", "release"],
      "description": "Preuves de packaging, déploiement, migration et publication."
    }
  ],
  "nodes": [
    {
      "id": "preflight",
      "order": 10,
      "needs": [],
      "conditionalNeeds": [],
      "commands": [
        "Repository hygiene (README, encoding, secrets and DoD)",
        "Backlog consistency",
        "Backlog atomicity",
        "Test classification compliance",
        "Identity boundary",
        "Naming convention",
        "Maintainability ratchet"
      ],
      "profiles": ["pr", "main", "nightly", "release"],
      "reads": ["workspace", "git-index", "HEAD"],
      "writes": ["reports/test-execution-artifacts/{profile}/preflight/result.json"],
      "resources": [],
      "aggregator": false
    },
    {
      "id": "backend-static",
      "order": 20,
      "needs": ["preflight"],
      "conditionalNeeds": [],
      "commands": ["Backend lint (Ruff)"],
      "profiles": ["pr", "main", "nightly", "release"],
      "reads": ["backend", "Scripts", "tests", "pyproject.toml"],
      "writes": ["reports/test-execution-artifacts/{profile}/backend-static/result.json"],
      "resources": [],
      "aggregator": false
    },
    {
      "id": "statistical-authorities",
      "order": 25,
      "needs": ["preflight"],
      "conditionalNeeds": [],
      "commands": [
        "Statistical authority and enforcement policy validation",
        "Statistical corpus and probes validation",
        "Statistical distribution protocol validation"
      ],
      "profiles": ["main", "nightly", "release"],
      "reads": ["config", "contracts", "docs/standards", "reports/statistical-distribution-calibration.json"],
      "writes": ["reports/test-execution-artifacts/{profile}/statistical-authorities"],
      "resources": [],
      "aggregator": false
    },
    {
      "id": "statistical-deterministic-parity",
      "order": 32,
      "needs": ["statistical-authorities"],
      "conditionalNeeds": [],
      "commands": [
        "Generate deterministic statistical parity evidence",
        "Blocking deterministic statistical parity"
      ],
      "profiles": ["main", "nightly", "release"],
      "reads": ["backend", "frontend/src", "frontend/scripts", "contracts"],
      "writes": ["reports/test-execution-artifacts/{profile}/statistical-deterministic-parity"],
      "resources": [],
      "aggregator": false
    },
    {
      "id": "statistical-exact-replay",
      "order": 34,
      "needs": ["statistical-authorities"],
      "conditionalNeeds": [],
      "commands": [
        "Generate exact replay and batching evidence",
        "Blocking exact interlanguage replay",
        "Blocking statistical batching independence"
      ],
      "profiles": ["main", "nightly", "release"],
      "reads": ["backend", "frontend/src", "frontend/scripts", "contracts"],
      "writes": ["reports/test-execution-artifacts/{profile}/statistical-exact-replay"],
      "resources": [],
      "aggregator": false
    },
    {
      "id": "statistical-distributional-parity",
      "order": 36,
      "needs": ["statistical-authorities"],
      "conditionalNeeds": [],
      "commands": [
        "Generate distributional statistical parity evidence",
        "Blocking distributional statistical parity"
      ],
      "profiles": ["main", "nightly", "release"],
      "reads": ["backend", "frontend/src", "frontend/scripts", "contracts", "reports/statistical-distribution-calibration.json"],
      "writes": ["reports/test-execution-artifacts/{profile}/statistical-distributional-parity"],
      "resources": [],
      "aggregator": false
    },
    {
      "id": "statistical-compatibility",
      "order": 72,
      "needs": [
        "statistical-deterministic-parity",
        "statistical-exact-replay",
        "statistical-distributional-parity"
      ],
      "conditionalNeeds": [],
      "commands": [
        "Generate blocking statistical compatibility evidence",
        "Blocking statistical version compatibility"
      ],
      "profiles": ["main", "nightly", "release"],
      "reads": ["backend", "frontend/src", "Scripts", "contracts", "reports/test-execution-artifacts/{profile}"],
      "writes": ["reports/test-execution-artifacts/{profile}/statistical-compatibility"],
      "resources": [],
      "aggregator": false
    },
    {
      "id": "statistical-consolidated-report",
      "order": 80,
      "needs": [
        "statistical-deterministic-parity",
        "statistical-exact-replay",
        "statistical-distributional-parity",
        "statistical-compatibility"
      ],
      "conditionalNeeds": [],
      "commands": [
        "Generate current-run consolidated statistical report",
        "Independently validate current-run consolidated statistical report",
        "Blocking consolidated statistical verdict"
      ],
      "profiles": ["main", "nightly", "release"],
      "reads": ["contracts", "docs/standards", "reports/test-execution-artifacts/{profile}"],
      "writes": ["reports/test-execution-artifacts/{profile}/statistical-consolidated-report"],
      "resources": [],
      "aggregator": false
    },
    {
      "id": "frontend-static",
      "order": 30,
      "needs": ["preflight"],
      "conditionalNeeds": [],
      "commands": [
        "Frontend lint (ESLint, zero warning)",
        "Frontend typecheck (TypeScript)",
        "Frontend build"
      ],
      "profiles": ["pr", "main", "nightly", "release"],
      "reads": ["frontend/src", "frontend/package-lock.json"],
      "writes": [
        "reports/test-execution-artifacts/{profile}/frontend-static/dist",
        "reports/test-execution-artifacts/{profile}/frontend-static/result.json"
      ],
      "resources": [],
      "aggregator": false
    },
    {
      "id": "backend-tests",
      "order": 40,
      "needs": ["preflight"],
      "conditionalNeeds": [],
      "commands": [
        "Prepare backend test selection",
        "Selected backend tests",
        "Backend tests",
        "Versioned Python coverage",
        "Python coverage scope and per-file compliance"
      ],
      "profiles": ["pr", "main", "nightly", "release"],
      "reads": ["backend", "Scripts", "tests", "reports/test-classification-inventory.json"],
      "writes": [
        "reports/test-execution-artifacts/{profile}/backend-tests/coverage.json",
        "reports/test-execution-artifacts/{profile}/backend-tests/pytest-args.txt",
        "reports/test-execution-artifacts/{profile}/backend-tests/pytest.json"
      ],
      "resources": ["mongo-backend-tests"],
      "aggregator": false
    },
    {
      "id": "frontend-tests",
      "order": 50,
      "needs": ["preflight"],
      "conditionalNeeds": [],
      "commands": [
        "Selected frontend unit tests (Vitest)",
        "Frontend unit tests (Vitest)",
        "Frontend unit coverage"
      ],
      "profiles": ["pr", "main", "nightly", "release"],
      "reads": ["frontend/src", "reports/test-classification-inventory.json"],
      "writes": [
        "reports/test-execution-artifacts/{profile}/frontend-tests/coverage/coverage-final.json",
        "reports/test-execution-artifacts/{profile}/frontend-tests/vitest.json"
      ],
      "resources": [],
      "aggregator": false
    },
    {
      "id": "e2e",
      "order": 60,
      "needs": ["preflight"],
      "conditionalNeeds": [],
      "commands": ["End-to-end tests (Playwright)"],
      "profiles": ["pr", "main", "nightly", "release"],
      "reads": ["frontend/src", "backend", "reports/test-classification-inventory.json"],
      "writes": [
        "reports/test-execution-artifacts/{profile}/e2e/e2e-coverage-summary.json",
        "reports/test-execution-artifacts/{profile}/e2e/playwright.json"
      ],
      "resources": ["ports-8000-4173"],
      "aggregator": false
    },
    {
      "id": "release-or-container-checks",
      "order": 70,
      "needs": ["preflight"],
      "conditionalNeeds": [],
      "commands": ["Release or container checks"],
      "profiles": ["pr", "main", "nightly", "release"],
      "reads": ["Dockerfile", "docker-compose.yml", ".env"],
      "writes": ["reports/test-execution-artifacts/{profile}/release-or-container-checks/result.json"],
      "resources": ["docker-compose-project", "port-18080"],
      "aggregator": false
    },
    {
      "id": "aggregate",
      "order": 100,
      "needs": [
        "backend-static",
        "frontend-static",
        "backend-tests",
        "frontend-tests",
        "e2e",
        "release-or-container-checks"
      ],
      "conditionalNeeds": ["statistical-consolidated-report"],
      "commands": [
        "Verify global execution count reference",
        "Vitals coverage report",
        "Vitals compliance",
        "Test governance compliance",
        "Test strategy reporting"
      ],
      "profiles": ["pr", "main", "nightly", "release"],
      "reads": [
        "reports/test-execution-artifacts/{profile}",
        "tests",
        "frontend/src",
        "frontend/tests/e2e",
        "frontend/package-lock.json"
      ],
      "writes": [
        "reports/test-execution-counts.json",
        "reports/test-execution-plan.json",
        "reports/test-governance-report.json",
        "reports/test-strategy-report.json",
        "reports/test-strategy-report.md",
        "frontend/coverage/vitals-coverage-report.json"
      ],
      "resources": [],
      "aggregator": true
    }
  ]
}
