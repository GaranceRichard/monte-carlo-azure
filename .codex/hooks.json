{
  "description": "Prepare the worktree-local Python runtime before Codex runs its first command.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel)/.githooks/python-env\" \"$(git rev-parse --show-toplevel)\"",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& (Join-Path (& git rev-parse --show-toplevel) '.codex/bootstrap-python.ps1')\"",
            "timeout": 600,
            "statusMessage": "Preparing the worktree Python environment"
          }
        ]
      }
    ]
  }
}
