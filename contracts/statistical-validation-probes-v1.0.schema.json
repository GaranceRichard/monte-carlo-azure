{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://montecarlo.local/schemas/statistical-validation-probes/1.0",
  "title": "Statistical validation probes",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "normative_contract", "cases"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "normative_contract": { "const": "STD-STAT-001" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/probe" }
    }
  },
  "$defs": {
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "input", "seed", "accepted"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "input": { "type": "object" },
        "seed": {},
        "accepted": { "type": "boolean" }
      }
    }
  }
}
